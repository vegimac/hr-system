<Project Sdk="Microsoft.NET.Sdk">
  <!-- ================================================================
       Test-Projekt für Schaub HR-System
       Walter-Vorgabe 17.05.2026: zentrale Lohnlauf-Edit-Sperre durch
       automatisierte Tests absichern.

       Laufen mit:  dotnet test Tests/hr-system.Tests.csproj
       (oder einfach: cd Tests && dotnet test)
       ================================================================ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HrSystem.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offizielle Swissdec-ELM-6.0-Schemata (Walter 16.08.2026) fuer die
         XSD-Validierung des TxAB-Barcode-XMLs. -->
    <None Include="TestData\Swissdec\*.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenz auf das Haupt-Projekt: gibt uns Zugriff auf
         HrSystem.Data.AppDbContext, HrSystem.Services.LohnEditLockService,
         alle Models, und alle Controller. -->
    <ProjectReference Include="..\hr-system.csproj" />
  </ItemGroup>

</Project>
