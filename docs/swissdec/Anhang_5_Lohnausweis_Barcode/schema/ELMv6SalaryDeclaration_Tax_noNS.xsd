                        <short>7 Autres prestations</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Altre prestazioni (c7)</translation>
                        <short>7 Altre prestazioni</short>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="GrossIncome" type="SalaryAmountType">
