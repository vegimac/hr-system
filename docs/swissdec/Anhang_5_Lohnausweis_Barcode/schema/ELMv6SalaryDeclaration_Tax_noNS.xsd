                    <xs:documentation xml:lang="de">
                        <translation>Bruttorente (z8)</translation>
                        <short>8 Bruttorente: Total der Einkünfte gemäss Ziffern 1-7</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Rente brute (c8)</translation>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Rendita lorda (c8)</translation>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="NetIncome" type="SalaryAmountType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Nettorente (z11)</translation>
                        <short>11 Nettorente</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Rente nette (c11)</translation>
                        <short>11 Rente nette</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Rendita netta (c11)</translation>
                        <short>11 Rendita netta</short>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DeductionAtSource" type="SalaryAmountType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Quellensteuerabzug (z12)</translation>
                        <short>12 Quellensteuerabzug: Totalbetrag der abgezogenen Quellensteuern</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Déduction de l’impôt à la source (c12)</translation>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Deduzione dell'imposta alla fonte (c12)</translation>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Remark" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Freies Textfeld für Bemerkungen (z15)</translation>
                        <short>15 Freies Textfeld für Bemerkungen</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Champ de texte libre pour remarques (c15)</translation>
                        <short>15 Champ de texte libre pour remarques</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Campo testo libero per osservazioni (c15)</translation>
                        <short>15 Campo testo libero per osservazioni</short>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="StandardRemark" type="StandardRemarkAnnuityType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Standardbemerkungen (z15)</translation>
                        <short>15 Standardbemerkungen</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Remarques standards (c15)</translation>
                        <short>15 Remarques standards</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Osservazioni standard (c15)</translation>
                        <short>15 Osservazioni standard</short>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="addresseeIDRef" type="InstanceRefIDType" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="de">
                    <translation>Institution Identifikation Referenz</translation>
                </xs:documentation>
                <xs:documentation xml:lang="fr">
                    <translation>Référence Institution Identificateur</translation>
