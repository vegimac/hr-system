    </xs:complexType>
    <xs:complexType name="StandardRemarkAnnuityType">
        <xs:sequence>
            <xs:element name="Rectificate" type="RectificateType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Rektifikat</translation>

                        <short>Rektifikat einer fehlerhaften Rentenbescheinigung</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Rectification</translation>

                        <short>Rectification d’une attestation de rente incorrecte</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Rettificazione</translation>

                        <short>Rettificazione di un'attestazione delle rendite errata</short>

                    </xs:documentation>
