                        <short>2 Gehaltsnebenleistungen, die bewertet werden können</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Prestations salariales accessoires (c2)</translation>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Prestazioni accessorie al salario (c2)</translation>
                    </xs:documentation>
                    <xs:documentation>
                        <usage>Tax</usage>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SporadicBenefits" type="SortSumType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Unregelmässige Leistungen (z3)</translation>
                        <short>3 Unregelmässige Leistungen: Einmalige Zuschüsse, Zusatzrente im Todesfall, etc.</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
