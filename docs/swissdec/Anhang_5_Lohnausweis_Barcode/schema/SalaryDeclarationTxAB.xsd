           elementFormDefault="qualified" attributeFormDefault="unqualified" version="0.0">

    <!--
         Include -->
    <xs:include schemaLocation="ELMv6SalaryDeclaration_Tax_noNS.xsd"/>
    <!--

        elements -->
    <xs:element name="T" type="sdtab:SalaryDeclarationTaxAccBcdType"/>
    <!--

        SalaryDeclaration Tax with 2dBarcode
    -->
    <xs:complexType name="SalaryDeclarationTaxAccBcdType">
        <xs:sequence>
            <!--
                company data -->
            <xs:element name="Company" type="sdtab:CompanyIDType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Unternehmen</translation>

                        <short>Unternehmensbeschreibung</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Entreprise</translation>

                        <short>Description d'entreprise</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Azienda</translation>
                        <short>Descrizione dell'azienda</short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <!--
                person data -->
            <xs:element name="PersonID" type="sdtab:PersonIDType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>PersonID</translation>

                        <short>Identifikation der Person</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>PersonID</translation>

                        <short>Identification de la Person</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>PersonID</translation>
                        <short>Identificazione della persona</short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <!--
                salary data -->
            <xs:choice>
                <!--
                    text-recombine
                    with namespace sd:http://www.swissdec.ch/schema/sd/20200220/SalaryDeclaration -->
                <xs:element name="A" type="sdtab:TaxAnnuityType">
                    <xs:annotation>
                        <xs:documentation xml:lang="de">
                            <translation>B: Rentenbescheinigung</translation>
                            <short>Für Leistungen einer Vorsorgeeinrichtung aufgrund eines
                                Rentenanspruchs
                            </short>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr">
                            <translation>B: Attestation de rente</translation>
                            <short>pour les prestations d’une institution de prévoyance sur la base
                                d’un droit à la rente
                            </short>
                        </xs:documentation>
                        <xs:documentation xml:lang="it">
                            <translation>B: attestazione delle rendite</translation>
                            <short>per prestazioni di un'istituzione previdenziale in virtù di un
                                diritto alla rendita
                            </short>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="S" type="sdtab:TaxSalaryType">
                    <xs:annotation>
                        <xs:documentation xml:lang="de">
                            <translation>A: Lohnausweis</translation>

                            <short>Für Leistungen aufgrund eines Arbeitsverhältnisses</short>

                        </xs:documentation>
                        <xs:documentation xml:lang="fr">
                            <translation>A: Certificat de salaire</translation>
                            <short>Pour les prestations sur la base d’un rapport de travail</short>
                        </xs:documentation>
                        <xs:documentation xml:lang="it">
                            <translation>A: certificato di salario</translation>
                            <short>Per le prestazioni in virtù di un rapporto di lavoro</short>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="OA" type="sdtab:FormularAType">
                    <xs:annotation>
                        <xs:documentation xml:lang="de">
                            <translation>MB: Detail Mitarbeiterbeteiligung</translation>

                            <short>Als Beiblatt zum Lohnausweis bzw. zur QST-Abrechnung für Empfänger von
                                geldwerten Leistungen aus Mitarbeiterbeteiligungen.
                                Formular A: Für Mitarbeiteraktien und freie börsenkotierte
                                Mitarbeiteroptionen.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="fr">
                            <translation>PC: Détail participation de collaborateur</translation>

                            <short>comme feuille annexe au certificat de salaire, respectivement au décompte IS
                                pour les bénéficiaires de prestations appréciables en argent issues de participations
                                de collaborateur.
                                Formulaire A : Pour les actions de collaborateurs et les options de
                                collaborateur libres cotées en bourse.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="it">
                            <translation>MB: dettaglio partecipazione di collaboratore</translation>

                            <short>come allegato al certificato di salario ovvero al conteggio IF per
                                beneficiari di
                                prestazioni valutabili in denaro derivanti da partecipazioni di collaboratore.
                                Modulo A: Opzioni di collaboratore quotate e liberamente
                                negoziabili
                            </short>

                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="OB" type="sdtab:FormularBType">
                    <xs:annotation>
                        <xs:documentation xml:lang="de">
                            <translation>MB: Detail Mitarbeiterbeteiligung</translation>

                            <short>Als Beiblatt zum Lohnausweis bzw. zur QST-Abrechnung für Empfänger von
                                geldwerten
                                Leistungen aus Mitarbeiterbeteiligungen.
                                Formular B: Bei vorzeitigem Wegfall der Sperrfrist oder bei Rückgabe von
                                Mitarbeiteraktien.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="fr">
                            <translation>PC: Détail participation de collaborateur</translation>

                            <short>comme feuille annexe au certificat de salaire, respectivement au décompte IS
                                pour
                                les bénéficiaires de prestations appréciables en argent issues de participations
                                de collaborateur.
                                Formulaire B : En cas de suppression anticipée du délai de blocage ou en cas
                                de restitution d’actions de collaborateur.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="it">
                            <translation>MB: dettaglio partecipazione di collaboratore</translation>

                            <short>come allegato al certificato di salario ovvero al conteggio IF per
                                beneficiari di
                                prestazioni valutabili in denaro derivanti da partecipazioni di collaboratore.
                                Modulo B: In caso di fine anticipata del termine di attesa o di
                                restituzione di azioni di collaboratore.
                            </short>

                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="OC" type="sdtab:FormularCType">
                    <xs:annotation>
                        <xs:documentation xml:lang="de">
                            <translation>MB: Detail Mitarbeiterbeteiligung</translation>

                            <short>Als Beiblatt zum Lohnausweis bzw. zur QST-Abrechnung für Empfänger von
                                geldwerten Leistungen aus Mitarbeiterbeteiligungen.
                                Formular C: Für übrige Mitarbeiteroptionen, Anwartschaften auf
                                Mitarbeiteraktien oder unechte Mitarbeiterbeteiligungen.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="fr">
                            <translation>PC: Détail participation de collaborateur</translation>

                            <short>comme feuille annexe au certificat de salaire, respectivement au décompte IS
                                pour
                                les bénéficiaires de prestations appréciables en argent issues de participations
                                de collaborateur.
                                Formulaire C : Pour d’autres options de collaborateur, prétentions sur les
                                actions de collaborateurs ou participations impropres de collaborateurs.
                            </short>

                        </xs:documentation>
                        <xs:documentation xml:lang="it">
                            <translation>MB: dettaglio partecipazione di collaboratore</translation>

                            <short>come allegato al certificato di salario ovvero al conteggio IF per
                                beneficiari di
                                prestazioni valutabili in denaro derivanti da partecipazioni di collaboratore.
                                Modulo C: Per altre opzioni di collaboratore, aspettative su azioni al
                                collaboratore o partecipazioni dei collaboratori improprie.
                            </short>

                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="SID" type="sdtab:SIDType" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="de">
                    <translation>SystemID</translation>

                    <short>SystemID, Kennzeichen des Herstellers</short>
                    <technical>Die SystemID wird während der Zertifizierung definiert und durch swissdec
                        verwaltet und publiziert.
                    </technical>

                </xs:documentation>
                <xs:documentation xml:lang="fr">
                    <translation>SystemID</translation>

                    <short>SystemID, Identification du développeur</short>
                    <technical>Le SystemID est défini pendant la certification. Il est
                        administré et publié par swissdec.
                    </technical>

                </xs:documentation>
                <xs:documentation xml:lang="it">
                    <translation>SystemID</translation>
                    <short>SystemID, segno distintivo del produttore</short>
                    <technical>L'identificativo di sistema viene definito durante la certificazione e gestito e pubblicato da Swissdec.
                    </technical>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="SysV" type="sdtab:SysVType" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="de">
                    <translation>SystemVersion</translation>

                    <short>SystemVersion</short>
                    <technical>Die SystemVersion wird durch den Hersteller gepflegt. In Problemfällen wird
                        damit die Suche nach der Ursache eingegrenzt.
                    </technical>

                </xs:documentation>
                <xs:documentation xml:lang="fr">
                    <translation>SystemVersion</translation>

                    <short>SystemVersion</short>
                    <technical>SystemVersion est administré par le développeur. Au cas de
                        problèmes, la vérsion aide à analyser la cause de l'erreur.
                    </technical>

                </xs:documentation>
                <xs:documentation xml:lang="it">
                    <translation>SystemVersion</translation>
                    <short>SystemVersion</short>
                    <technical>La versione del sistema viene curata dal produttore. In caso di problemi,
                        questo permette di restringere la ricerca della causa.
                    </technical>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
