    <xs:complexType name="CheckInteroperabilityRequestType">
        <xs:sequence>
            <xs:element name="UserAgent" type="ep:UserAgentType"/>
            <!-- use following UmlautString: ÄËÖÜÁÉÓÚÀÈÒÙÂÊÔÛ -->
            <xs:element name="UmlautString" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Anordnung von Umlauten</translation>

                        <short>Anordnung von Umlauten zum Testen des Encodings bei Sonderzeichen.</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Chaîne de caracères spéciaux</translation>

                        <short>Arrangement des trémas pour tester l'encodage des caractères spéciaux.</short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>stringa con dieresi</translation>

                        <short>Disposizione delle lettere con dieresi per testare la codifica dei caratteri speciali.
                        </short>

                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <!-- use following value for the FirstOperand: 999000000000.00 (999 milliards)-->
            <!-- verwende folgenden Wert als FirstOperand: 999000000000.00 (999 Milliarden)-->
            <xs:element name="FirstOperand" type="ep:SalaryAmountType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>1. vorgegebene Testgrösse</translation>

                        <short>
                            1. Operand wird mit 2. Operand zusammengerechnet zum Testen, dass keine Datentyp-Fehler
                            passieren.
                        </short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>1. taille d'essai spécifiée</translation>

                        <short>
                            1. L'opérande est ajoutée avec 2. L'opérande pour vérifier qu'aucune erreur de type de
                            données ne se produit.
                        </short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>1. dimensione di prova specificata</translation>

                        <short>
                            1. L'operando viene aggiunto con 2. L'operando per verificare che non ci siano errori di
                            tipo
                            i dati non si verificano.
                        </short>

                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SecondOperand" type="ep:SalaryAmountType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>2. vorgegebene Testgrösse</translation>

                        <short>
                            2. Operand wird mit 1. Operand zusammengerechnet zum Testen, dass keine Datentyp-Fehler
                            passieren.
                        </short>

                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>2. taille d'essai spécifiée</translation>

                        <short>
                            La 2ᵉ opérande est ajoutée avec la 1ᵉre opérande pour vérifier qu'aucune erreur de
                            type de données ne se produit.
                        </short>

                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>2. dimensione di prova specificata</translation>

                        <short>
                            Il 2° operando viene aggiunto con il 1° operando per verificare che non ci siano errori
                            di
                            il tipo di dati non si verifica.
                        </short>

                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SystemDateTime" type="xs:dateTime">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Aktuelle Systemzeit</translation>
                        <short>Aktuelle Systemzeit</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Temps du système actuelle</translation>
                        <short>Temps du système actuelle</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Tempo di sistema attuale</translation>
                        <short>Tempo di sistema attuale</short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <!-- MonitoringID: acts as identifier for writing and accessing
                monitoring information in/from a reference application
                (related to testing and certification) -->
            <xs:element name="MonitoringID" type="ep:MonitoringIDType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
