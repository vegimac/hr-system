                        <short>Disposizione delle lettere con dieresi per testare la codifica dei caratteri speciali.
                        </short>

                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AdditionResult" type="ep:SalaryAmountType">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Ergebnis der Addition</translation>
                        <short>Summe der beiden Operanden des Interoperabilitätstests</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>résultat de l'addition</translation>
                        <short>Somme des deux opérandes du test d'interopérabilité</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>risultato dell'addizione</translation>
                        <short>Somma dei due operandi del test di interoperabilità</short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SubtractionResult" type="ep:SalaryAmountType">
