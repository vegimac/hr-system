                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>beendet</translation>
                        <short>Detaillierte Beschreibungen, welche zu einer erfolgreichen Meldung
                            führten.
                        </short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>terminé</translation>
                        <short>Descriptions prédéfinies pour une transmission réussie.</short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>finito</translation>
                        <short>Descrizioni predefinite per una dichiarazione conforme.</short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Reject" type="ep:NotificationsType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>beendet</translation>
                        <short>Detaillierte Beschreibungen, welche zu einer Rückweisung führten, weil z.B. die
                            Schwellenwerte von Regeln über alle Personen überschritten wurden.
                        </short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>rejeter</translation>
