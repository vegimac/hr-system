                        </short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Info" type="ep:NotificationsType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="de">
                        <translation>Informationen</translation>
                        <short>Vordefinierte Beschreibungen, welche nicht zur einer Rückweisung führen und als reine
                            Information dienen.
                        </short>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Informations</translation>
                        <short>Descriptions prédéfinies qui n'entraînent pas de rejet et servent uniquement
                            d'information.
                        </short>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
                        <translation>Informazioni</translation>
                        <short>Descrizioni predefinite che non comportano un rifiuto e hanno solo scopo informativo.
                        </short>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

