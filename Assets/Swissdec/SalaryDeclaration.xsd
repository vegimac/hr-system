                        <translation>Zeitpunkt der Erstellung</translation>
                        <short>Zeitpunkt der Erstellung der Urkunde</short>
                        <technical>Zeitpunkt der Erstellung der Urkunde</technical>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Date de création</translation>
                        <short>Date de création du document</short>
                        <technical>Date de création du document</technical>
                    </xs:documentation>
                    <xs:documentation xml:lang="it">
