                        <translation>Steuerbares Erwerbseinkommen des Arbeitnehmers aus
                            Mitarbeiterbeteiligungen (z5)
                        </translation>
                        <short>5 Steuerbares Erwerbseinkommen des Arbeitnehmers aus Mitarbeiterbeteiligungen
                            (Aktien und /oder Optionen usw.).
                        </short>
                        <technical>5 Steuerbares Erwerbseinkommen des Arbeitnehmers aus Mitarbeiterbeteiligungen
                            (Aktien und /oder Optionen usw.).
                        </technical>
                    </xs:documentation>
                    <xs:documentation xml:lang="fr">
                        <translation>Revenu imposable de l’activité lucrative du travailleur issu
