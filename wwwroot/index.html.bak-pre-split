let _periodenRegelBranchId = null;

async function openPeriodenRegelModal(branchId) {
    _periodenRegelBranchId = branchId;
    const modal = document.getElementById('periodenRegelModal');
    const filialName = document.getElementById('prFilialName');
    const cur = document.getElementById('prCurrentConfig');
    const histWrap = document.getElementById('prHistoryWrap');
    const hist = document.getElementById('prHistory');
    const err = document.getElementById('prError');
    err.textContent = '';

    const b = allBranches.find(x => x.id === branchId);
    filialName.textContent = b ? `${b.restaurantCode || ''} ${b.branchName || b.companyName || ''}`.trim() : '';

    // Aktuelle + Historie laden
    try {
        const resAll = await fetch(`/api/payroll-perioden/config/all?companyProfileId=${branchId}`, { headers: ah() });
        const all = resAll.ok ? await resAll.json() : [];

        if (!all.length) {
            cur.innerHTML = `<strong>Keine Periodenregel konfiguriert.</strong> Standard: 1.–31. (ganzer Monat). Lege unten eine Regel an, sobald du auf eine andere Periode wechseln willst.`;
            histWrap.style.display = 'none';
        } else {
            // Erste = aktuelle (sortiert DESC nach ValidFromYear/Month)
            const c0 = all[0];
            const monatsName = ['','Jan.','Feb.','März','April','Mai','Juni','Juli','Aug.','Sept.','Okt.','Nov.','Dez.'];
            const lockedBadge = c0.isLocked
                ? '<span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:600;margin-left:8px">Gesperrt</span>'
                : '<span style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:600;margin-left:8px">Noch ungenutzt</span>';
            cur.innerHTML = `
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    <strong>Aktiv:</strong>
                    <span>${c0.fromDay}.–${c0.toDay}. des Monats</span>
                    <span style="color:#0369a1">· gültig ab ${monatsName[c0.validFromMonth]} ${c0.validFromYear}</span>
                    ${lockedBadge}
                </div>`;
            // Historie (alle ausser dem aktuellen)
            if (all.length > 1) {
                histWrap.style.display = 'block';
                hist.innerHTML = all.slice(1).map(c =>
                    `<div style="padding:5px 0;border-bottom:1px dotted #e2e8f0">
                        ${c.fromDay}.–${c.toDay}. · gültig ab ${monatsName[c.validFromMonth]} ${c.validFromYear}
                        <span style="color:#94a3b8;font-size:11px;margin-left:8px">${c.isLocked ? 'gesperrt' : 'ungenutzt'}</span>
                    </div>`
                ).join('');
            } else {
                histWrap.style.display = 'none';
            }
        }
    } catch (e) {
        cur.innerHTML = `<span style="color:#dc2626">Fehler beim Laden: ${e.message}</span>`;
        histWrap.style.display = 'none';
    }

    // Defaults im Form: Vorschlag = nächster Monat
    const now = new Date();
    let nextMonth = now.getMonth() + 2;   // +1 für 1-basiert, +1 für nächster Monat
    let nextYear  = now.getFullYear();
    if (nextMonth > 12) { nextMonth = 1; nextYear++; }
    document.getElementById('prFromDay').value         = '';
    document.getElementById('prValidFromYear').value   = nextYear;
    document.getElementById('prValidFromMonth').value  = nextMonth;

    modal.style.display = 'flex';
}

function closePeriodenRegelModal() {
    document.getElementById('periodenRegelModal').style.display = 'none';
    _periodenRegelBranchId = null;
}

async function savePeriodenRegel() {
    if (!_periodenRegelBranchId) return;
    const err = document.getElementById('prError');
    err.textContent = '';

    const fromDay        = parseInt(document.getElementById('prFromDay').value, 10);
    const validFromYear  = parseInt(document.getElementById('prValidFromYear').value, 10);
    const validFromMonth = parseInt(document.getElementById('prValidFromMonth').value, 10);

    if (!Number.isFinite(fromDay) || fromDay < 1 || fromDay > 28) {
        err.textContent = 'Periodenstart-Tag muss zwischen 1 und 28 liegen.'; return;
    }
    if (!Number.isFinite(validFromYear) || validFromYear < 2024 || validFromYear > 2099) {
        err.textContent = 'Gültig ab Jahr ungültig.'; return;
    }
    if (!Number.isFinite(validFromMonth) || validFromMonth < 1 || validFromMonth > 12) {
        err.textContent = 'Gültig ab Monat ungültig.'; return;
    }

    // ToDay automatisch ableiten: 1 → 31, sonst (fromDay - 1)
    const toDay = fromDay <= 1 ? 31 : fromDay - 1;

    try {
        const res = await fetch('/api/payroll-perioden/config', {
            method: 'POST',
            headers: { ...ah(), 'Content-Type': 'application/json' },
            body: JSON.stringify({
                companyProfileId: _periodenRegelBranchId,
                fromDay, toDay, validFromYear, validFromMonth
            })
        });
        if (!res.ok) {
            const e = await res.json().catch(() => ({}));
            err.textContent = e.message || e.error || 'Fehler beim Speichern.';
            return;
        }
        if (typeof showToast === 'function') {
            showToast(`Periodenregel ${fromDay}.–${toDay}. gespeichert (gültig ab ${validFromMonth}/${validFromYear})`, 'success');
        }
        closePeriodenRegelModal();
        loadFilialen();
    } catch (e) {
        err.textContent = 'Verbindungsfehler: ' + e.message;
    }
}

