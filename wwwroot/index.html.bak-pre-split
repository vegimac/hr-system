// ── STEMPELZEITEN-IMPORT FILIALE ──────────────────────
let stzActiveBranch = null;  // {id, restaurantCode, branchName}

function populateStzBranchSelect() {
    const sel = document.getElementById('stzBranchSelect');
    if (!sel) return;
    const branches = (typeof allBranches !== 'undefined' && Array.isArray(allBranches)) ? allBranches : [];
    if (!branches.length) { sel.innerHTML = '<option value="">— Keine Filialen verfügbar —</option>'; return; }
    const sorted = [...branches].sort((a,b) =>
        (a.restaurantCode || '').localeCompare(b.restaurantCode || ''));
    sel.innerHTML = sorted.map(b => {
        const code = b.restaurantCode || '';
        const name = b.branchName || b.companyName || '';
        return `<option value="${b.id}">${code ? code + ' – ' : ''}${name}</option>`;
    }).join('');
    // Vorauswahl aus aktiver Filiale
    if (fixedCompanyProfileId) sel.value = String(fixedCompanyProfileId);
    onStzBranchChange();
}

function onStzBranchChange() {
    const sel = document.getElementById('stzBranchSelect');
    if (!sel) return;
    const id = parseInt(sel.value, 10) || null;
    if (!id) { stzActiveBranch = null; return; }
    const b = (allBranches || []).find(x => x.id === id);
    stzActiveBranch = b ? {
        id: b.id,
        restaurantCode: b.restaurantCode || '',
        branchName: b.branchName || b.companyName || ''
    } : null;
}

// Prüft die im PDF gefundenen Mitarbeiter-Nummern gegen den Restaurant-Code
// der aktiven Filiale. Personalnummern beginnen mit dem RestaurantCode ohne
// führende Nullen (z.B. 058 → "58", 075 → "75", 104 → "104").
//
// Erwartet { parsedSample: [{emp,...}, ...] } aus der Preview-API. Liefert
// HTML-Warnung wenn die Mehrheit der Sample-Nummern zu einer ANDEREN Filiale
// gehört, sonst leeren String.
function buildStzBranchMismatchWarning(data) {
    if (!stzActiveBranch) return '';
    const sample = (data && data.parsedSample) || [];
    if (!sample.length) return '';

    const branchByPrefix = {};
    for (const b of (allBranches || [])) {
        const prefix = (b.restaurantCode || '').replace(/^0+/, '');
        if (prefix) branchByPrefix[prefix] = b;
    }
    const activePrefix = (stzActiveBranch.restaurantCode || '').replace(/^0+/, '');

    let mismatchCount = 0;
    let matchCount    = 0;
    let detected      = null;
    for (const e of sample) {
        const empNr = String(e.emp || '');
        // Match auf längsten passenden Präfix (3-stellig vor 2-stellig)
        let bMatch = null;
        for (const [pfx, b] of Object.entries(branchByPrefix).sort((a,b) => b[0].length - a[0].length)) {
            if (empNr.startsWith(pfx)) { bMatch = b; break; }
        }
        if (!bMatch) continue;
        if (bMatch.id === stzActiveBranch.id) matchCount++;
        else { mismatchCount++; detected = bMatch; }
    }

    // Nur warnen wenn deutliche Mehrheit zu anderer Filiale gehört
    if (matchCount >= mismatchCount || !detected) return '';

    return `<div class="import-result-err" style="margin-bottom:10px">
        <strong>⚠️ Achtung: PDF stammt aus anderer Filiale!</strong>
        <div style="font-size:13px;margin-top:4px">
            Personalnummern im PDF gehören zur Filiale
            <strong>${detected.restaurantCode || ''} – ${detected.branchName || detected.companyName || ''}</strong><br>
            Gewählte Filiale: <strong>${stzActiveBranch.restaurantCode} – ${stzActiveBranch.branchName}</strong><br>
            Bitte oben die richtige Filiale wählen oder ein anderes PDF importieren.
        </div>
    </div>`;
}

// ══════════════════════════════════════════════
// BRANCHES
// ══════════════════════════════════════════════
async function loadAllBranches() {
    try {
        const res = await fetch('/api/companyprofiles', { headers: ah() });
        allBranches = res.ok ? await res.json() : [];
    } catch { allBranches = []; }
}

function populateBranchSelector() {
    const sel = document.getElementById('branchSelect');
    sel.innerHTML = '<option value="">Alle Filialen</option>';
    const visible = (currentUser.branches === 'all'
        ? allBranches
        : allBranches.filter(b => currentUser.branches?.some(ub => ub.id === b.id))
    ).slice().sort((a, b) => parseInt(a.restaurantCode||'9999',10) - parseInt(b.restaurantCode||'9999',10));
    visible.forEach(b => {
        const o = document.createElement('option');
        o.value = b.id;
        o.textContent = `${b.restaurantCode ? b.restaurantCode + ' – ' : ''}${b.branchName || b.companyName}`;
        sel.appendChild(o);
    });
    // Auto-Selektion: bei einer oder mehreren sichtbaren Filialen wird die
    // erste (nach restaurantCode sortiert) vorgewählt, damit der User nicht
    // manuell klicken muss. Wenn gewünscht kann er oben immer noch auf
    // "Alle Filialen" zurückstellen.
    if (visible.length >= 1) { sel.value = visible[0].id; onBranchChange(); }
}

function onBranchChange() {
    currentBranchId = document.getElementById('branchSelect').value || null;
    fixedCompanyProfileId = currentBranchId ? parseInt(currentBranchId) : null;

    if (currentPageName === 'mitarbeiter') {
        loadMitarbeiterList();
    } else if (currentPageName === 'vertraege') {
        loadVtList();
    } else if (currentPageName === 'lohn') {
        lohnBranchChanged();
    } else if (currentPageName === 'lohnlauf') {
        // Lohnlauf folgt der globalen Filial-Auswahl — kein eigener Picker mehr.
        llSyncFromGlobalBranch();
    } else if (currentPageName === 'dvelop-import') {
        // Auswahl-Liste der MA neu filtern (auf neue Filiale)
        dvelopLoadEmployees();
    } else if (currentPageName === 'perioden') {
        // Lohnperioden-Page folgt dem globalen Selektor.
        const sel = document.getElementById('perBranchSelect');
        if (sel) {
            const target = currentBranchId ? String(currentBranchId) : '';
            if (sel.value !== target) {
                sel.value = target;
                perBranchChanged();
            }
        }
    } else if (currentPageName === 'lse-export') {
        lseUpdateBranchInfo();
    } else if (currentPageName === 'dashboard') {
        loadDashboard();
    }
}

// ══════════════════════════════════════════════
