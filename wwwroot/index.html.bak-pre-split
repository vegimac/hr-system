                    <span style="color:#64748b">Keine Periodenregel konfiguriert — Standard: 1. bis 31. (ganzer Monat)</span>
                    <button class="btn btn-sm btn-outline" onclick="perOpenConfigForm(null)" style="margin-left:auto">Periodenregel festlegen</button>
                </div>`;
            return;
        }

        const locked = cfg.isLocked
            ? `<span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:600">Gesperrt (Perioden angelegt)</span>`
            : `<span style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:600">Änderbar</span>`;

        const editBtn = cfg.isLocked ? '' :
            `<button class="btn btn-sm btn-outline" onclick="perOpenConfigForm(${JSON.stringify(cfg).replace(/"/g,'&quot;')})" style="margin-left:auto">Anpassen</button>`;

        banner.style.display = 'block';
        banner.innerHTML = `
            <div style="background:#f0f9ff;border:1px solid #7dd3fc;border-radius:8px;padding:12px 18px;display:flex;align-items:center;gap:12px;font-size:13px">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="#0284c7" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span style="color:#0c4a6e;font-weight:600">Periodenregel:</span>
                <span style="color:#0369a1">${cfg.fromDay}. bis ${cfg.toDay}. des Monats</span>
                ${locked}
                ${editBtn}
            </div>`;
