const roleLabels = { GESCHAEFTSFUEHRER:'Geschäftsführer/in', HR_VERANTWORTLICH:'HR-Verantwortlich', BUCHHALTUNG:'Buchhaltung', SONSTIGES:'Sonstiges' };

