        const res    = await fetch(url, {
            method,
            headers: { ...ah(), 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if (!res.ok) {
            const e = await res.json().catch(() => ({}));
            errEl.textContent = e.error || 'Fehler beim Speichern.';
            return;
        }
        closeSslModal();
        loadSslListForBranch(companyId);
