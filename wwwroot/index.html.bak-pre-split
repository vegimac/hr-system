            <!-- E-Mail-Versand-Konfiguration. Singleton (smtp_setting in DB).
                 Wird vom Lohnlauf für die "Lohnzettel ist bereit"-Benachrichtigung
                 an MA mit hinterlegter E-Mail-Adresse genutzt.
                 Test-Modus: TestRedirectTo = Mailadresse → ALLE Mails
                 gehen dorthin (Subject [TEST → original@…]).
                 Nur admin-Rolle (Passwort-sensibel). -->
            <div class="page" id="page-smtp-settings">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">E-Mail-Versand</h1>
                        <p class="page-sub">SMTP-Konfiguration für Lohnzettel-Benachrichtigungen und andere automatische E-Mails.</p>
                    </div>
                </div>

                <div id="smtpAlert" style="margin-bottom:14px"></div>

                <div id="smtpTestBanner" style="display:none;margin-bottom:14px;background:#fef3c7;border:1px solid #fbbf24;border-radius:10px;padding:12px 16px;color:#92400e">
                    <strong>⚠️ Test-Modus aktiv:</strong>
                    Alle Mails gehen an <strong id="smtpTestBannerAddr">–</strong> statt an die eigentlichen Empfänger.
                    Im Subject erscheint <code>[TEST → original@adresse]</code>.
                    Zum Echtbetrieb: Feld „Test-Umleitung" leeren und speichern.
                </div>

                <div class="card" style="padding:20px;max-width:760px">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px 20px">
                        <div style="grid-column:1 / -1">
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">SMTP-Host</label>
                            <input id="smtpHost" type="text" placeholder="z.B. mail.infomaniak.com oder smtp.hostfactory.ch"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                        <div>
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Port</label>
                            <input id="smtpPort" type="number" min="1" max="65535" value="587"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                            <div style="font-size:11.5px;color:#94a3b8;margin-top:3px">587 = STARTTLS, 465 = SSL</div>
                        </div>
                        <div>
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Benutzername</label>
                            <input id="smtpUsername" type="text" placeholder="z.B. noreply@hr-srgmbh.ch"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                        <div style="grid-column:1 / -1">
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">
                                Passwort
                                <span id="smtpPwState" style="font-weight:500;color:#94a3b8;font-size:11.5px;margin-left:6px"></span>
                            </label>
                            <div style="display:flex;gap:8px">
                                <input id="smtpPassword" type="password" placeholder="••••••••"
                                       style="flex:1;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px"
                                       onfocus="smtpPwFocus()">
                                <button type="button" onclick="smtpPwToggle()" id="smtpPwToggleBtn"
                                        style="padding:9px 14px;border:1px solid #cbd5e1;border-radius:7px;background:#f8fafc;cursor:pointer;font-size:12px;color:#475569">
                                    👁 anzeigen
                                </button>
                                <button type="button" onclick="smtpPwClear()"
                                        style="padding:9px 14px;border:1px solid #fca5a5;border-radius:7px;background:#fef2f2;cursor:pointer;font-size:12px;color:#991b1b">
                                    Löschen
                                </button>
                            </div>
                            <div style="font-size:11.5px;color:#94a3b8;margin-top:3px">
                                Wird AES-verschlüsselt in der Datenbank abgelegt. Leer lassen = unverändert.
                            </div>
                        </div>
                        <div>
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Absender-Name</label>
                            <input id="smtpFromName" type="text" value="Schaub HR"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                        <div>
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Absender-Adresse</label>
                            <input id="smtpFromAddress" type="email" placeholder="z.B. noreply@hr-srgmbh.ch"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                        <div style="grid-column:1 / -1">
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">
                                Test-Umleitung (optional) <span style="color:#94a3b8;font-weight:500">— alle Mails an diese Adresse</span>
                            </label>
                            <input id="smtpTestRedirectTo" type="email" placeholder="z.B. walter.schaub@gmail.com — leer für Echtbetrieb"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                            <div style="font-size:11.5px;color:#94a3b8;margin-top:3px">
                                Solange dieses Feld gefüllt ist, gehen alle Mails an die Test-Adresse statt an MA.
                            </div>
                        </div>
                        <div style="grid-column:1 / -1">
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Site-URL (für Login-Link in Mails)</label>
                            <input id="smtpSiteUrl" type="text" placeholder="https://test.hr-srgmbh.ch/"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                    </div>

                    <div style="margin-top:18px;padding-top:16px;border-top:1px solid #e2e8f0;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                        <button class="btn btn-primary" onclick="smtpSave()" id="smtpSaveBtn">Speichern</button>
                        <button type="button" onclick="smtpLoad()"
                                style="padding:9px 16px;border:1px solid #cbd5e1;border-radius:8px;background:#f8fafc;cursor:pointer;font-size:13px;color:#475569">
                            Verwerfen / Neu laden
                        </button>
                        <span id="smtpSavedState" style="font-size:12px;color:#64748b;margin-left:auto"></span>
                    </div>
                </div>

                <div class="card" style="padding:20px;max-width:760px;margin-top:16px">
                    <div style="font-size:14.5px;font-weight:700;color:#0f172a;margin-bottom:8px">Test-Mail senden</div>
                    <div style="font-size:12.5px;color:#64748b;margin-bottom:14px">
                        Sendet eine kleine Bestätigungs-Mail mit den <strong>aktuell im Formular eingetragenen</strong>
                        Werten. Damit kannst du die Konfig verifizieren bevor du sie speicherst.
                        Wenn ein Test-Umleitungs-Adresse gesetzt ist, wird die Empfänger-Adresse automatisch dorthin umgelenkt.
                    </div>
                    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
                        <div style="flex:1;min-width:240px">
                            <label style="font-size:12.5px;font-weight:600;color:#475569;display:block;margin-bottom:4px">Empfänger der Test-Mail</label>
                            <input id="smtpTestTo" type="email" placeholder="z.B. walter.schaub@gmail.com"
                                   style="width:100%;padding:9px 11px;border:1px solid #cbd5e1;border-radius:7px;font-size:13.5px">
                        </div>
                        <button class="btn btn-primary" onclick="smtpSendTest()" id="smtpTestBtn">Test-Mail senden</button>
                    </div>
                    <div id="smtpTestResult" style="margin-top:14px"></div>
                </div>
            </div>

