        if (data.count === 0) {
            tbody.innerHTML = '<tr><td colspan="13" style="padding:30px;text-align:center;color:#94a3b8">Keine Datensätze für diesen Monat. Wahrscheinlich gibt es noch keine abgeschlossene Periode für die gewählte Filiale.</td></tr>';
